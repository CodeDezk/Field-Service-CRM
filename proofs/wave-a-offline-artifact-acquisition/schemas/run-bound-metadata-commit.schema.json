{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:field-service-crm:wave-a:run-bound-metadata-commit:v1",
  "title": "Wave A run-bound metadata commitment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runId", "stage", "sourcePolicySha256", "entries", "committedAt"],
  "properties": {
    "schema": { "const": "wave-a-run-bound-metadata-commit-v1" },
    "runId": { "type": "string", "minLength": 1 },
    "stage": { "const": "METADATA_COMMITTED" },
    "sourcePolicySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "committedAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "requestId", "version", "sourceId", "url", "outputRelativePath", "sha256", "size", "purpose"],
        "properties": {
          "artifactId": { "type": "string", "minLength": 1 },
          "requestId": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "sourceId": { "type": "string", "pattern": "^WP112-SOURCE-00[125]$" },
          "redirectedFromSourceId": { "const": "WP112-SOURCE-004" },
          "url": { "type": "string", "pattern": "^https://" },
          "outputRelativePath": { "type": "string", "pattern": "^quarantine/artifacts/" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 1 },
          "purpose": { "enum": ["EXECUTABLE_PROOF_ARTIFACT", "TRANSITIVE_PROOF_ARTIFACT", "SOURCE_REVIEW_ONLY"] }
        }
      }
    }
  }
}
